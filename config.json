{
  "data": {
    "base_url": "https://github.com/hetio/hetionet/raw/main/hetnet/",
    "raw_dir": "data/raw",
    "files": {
      "nodes": "tsv/hetionet-v1.0-nodes.tsv",
      "edges": "tsv/hetionet-v1.0-edges.sif.gz",
      "metagraph": "json/hetionet-v1.0-metagraph.json"
    }
  },
  "schema": {
    "label_edges": [
      ["Compound", "treats", "Disease"],
      ["Compound", "palliates", "Disease"]
    ],
    "target_edge": ["Compound", "binds", "Gene"],
    "association_edge": ["Disease", "associates", "Gene"],
    "context_edge": ["Gene", "participates", "Pathway"]
  },
  "subgraph": {
    "seed_diseases": [],
    "auto_seed_count": 8,
    "top_candidates": 5,
    "min_shared_targets": 2,
    "max_context_nodes": 40,
    "min_context_targets": 4,
    "out_dir": "web/data"
  },
  "ml": {
    "results_dir": "results",
    "seed": 42,
    "label_edge": ["Compound", "treats", "Disease"],
    "exclude_from_negatives": [["Compound", "palliates", "Disease"]],
    "split": { "test_fraction": 0.2, "test_negative_fraction": 0.5, "cv_folds": 5, "oof_folds": 10 },
    "bootstrap_samples": 1000,
    "negatives_per_positive": 10,
    "damping": 0.4,
    "metapaths": [
      "CbGaD",
      "CbGiGaD",
      "CbGpPWpGaD",
      "CuGdD",
      "CdGuD",
      "CbGbCtD",
      "CrCtD",
      "CiPCiCtD",
      "CcSEcCtD",
      "CtDrD",
      "CtDaGaD"
    ],
    "degree_features": [
      { "metaedge": "CbG", "node": "Compound" },
      { "metaedge": "CcSE", "node": "Compound" },
      { "metaedge": "DaG", "node": "Disease" },
      { "metaedge": "CtD", "node": "Compound" },
      { "metaedge": "CtD", "node": "Disease" }
    ],
    "models": {
      "degree_baseline": {
        "type": "feature_product",
        "grid": { "features": [["deg_CtD_Compound", "deg_CtD_Disease"]] }
      },
      "logistic_regression": {
        "type": "logistic_regression",
        "grid": { "C": [0.01, 0.1, 1.0, 10.0] }
      },
      "xgboost": {
        "type": "xgboost",
        "grid": {
          "n_estimators": [200, 500],
          "max_depth": [3, 5],
          "learning_rate": [0.05],
          "subsample": [0.8],
          "colsample_bytree": [0.8]
        }
      }
    },
    "selection_metric": "auprc",
    "ranking_ks": [1, 3, 10],
    "final": {
      "retrain_on_all_labels": true,
      "top_per_disease": 20,
      "max_evidence": 3,
      "explain": {
        "paths_per_metapath": 2,
        "beam_width": 200,
        "sanity_check_rows": 5
      }
    }
  },
  "gnn": {
    "model_name": "rgcn",
    "seed": 42,
    "validation_fold": "cv0",
    "val_negative_fraction": 1.0,
    "supervision_fraction": 0.3,
    "negatives_per_positive": 10,
    "max_epochs": 200,
    "eval_every": 10,
    "patience": 5,
    "graph_edges": "all",
    "graph_exclude": [],
    "num_bases": 8,
    "decoder": "distmult",
    "grid": {
      "hidden_dim": [64],
      "num_layers": [2, 3],
      "dropout": [0.5],
      "lr": [0.005],
      "weight_decay": [0.0, 0.0001]
    }
  },
  "predictions": {
    "file": "results/predictions.csv",
    "drug_column": "drug_id",
    "disease_column": "disease_id",
    "score_column": "score",
    "evidence_column": "evidence",
    "top_per_disease": 5,
    "relation": "predicted_treats",
    "explanations_file": "results/explanations.json",
    "show_explanation_paths": true
  }
}
